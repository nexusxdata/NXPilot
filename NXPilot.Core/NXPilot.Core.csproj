<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- DirectML: GPU opcional (qualquer placa DX12); o mesmo pacote traz o executor de CPU. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <!-- DPAPI: token e App Secret do WhatsApp cifrados no perfil do usuario (como o PAT do NXProject). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- Só o wrapper: as DLLs nativas do llama.cpp vêm da pasta da IA Local (C:\IA_LOCAL). -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pacote à parte (sem dependências): SQL Warehouse do Databricks; o gate entra por GateSqlApprover. -->
    <ProjectReference Include="..\NXPilot.Databricks\NXPilot.Databricks.csproj" />
    <!-- Pacote à parte (sem dependências): GitHub e Azure DevOps Repos; o gate entra por GateGitApprover. -->
    <ProjectReference Include="..\NXPilot.GitRepos\NXPilot.GitRepos.csproj" />
    <!-- Pacote à parte (sem dependências): leitura de e-mail Outlook/Gmail, somente leitura. -->
    <ProjectReference Include="..\NXPilot.Mail\NXPilot.Mail.csproj" />
    <!-- Pacote compartilhado com o NXProject: instala/localiza Claude Code e Codex (interno ou script). -->
    <ProjectReference Include="..\NXData.AgentInstaller\NXData.AgentInstaller.csproj" />
  </ItemGroup>

</Project>
