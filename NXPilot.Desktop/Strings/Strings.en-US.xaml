    <sys:String x:Key="Ext_TokenDatabricks">Databricks token (PAT)</sys:String>
    <sys:String x:Key="Ext_DatabricksGate">SELECT, SHOW and DESCRIBE run on their own. INSERT, UPDATE, DELETE, MERGE, DDL and GRANT ask for your approval.</sys:String>
