    <sys:String x:Key="Ext_TestarDevOps">Probar Azure DevOps</sys:String>
    <sys:String x:Key="Ext_EmailAviso">Solo lectura: NXPilot no envía, no elimina y no mueve correos. El contenido llega al agente como dato de terceros, nunca como instrucción.</sys:String>
