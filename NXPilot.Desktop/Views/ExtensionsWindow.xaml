<Window x:Class="NXPilot.Desktop.Views.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ext_Titulo}" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <!-- Uma "aba" por extensão, escolhida pela combo (pacotes NXPilot.Databricks / NXPilot.GitRepos / NXPilot.Mail; Work items no NXPilot.Core). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,18">
        <TextBlock Text="{DynamicResource Ext_Titulo}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap" Text="{DynamicResource Ext_Subtitulo}"/>

        <!-- Uma combo no lugar da faixa de abas: cabe qualquer número de extensões. Cada item repete a bolinha de status e o nome da aba. -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Ext_Extensao}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox x:Name="ExtensionBox" Padding="8,5" SelectionChanged="OnExtensionChanged"/>
        </DockPanel>
        <TabControl x:Name="Tabs" Padding="14,12" SelectionChanged="OnTabChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <!-- ============================== Databricks ============================== -->
            <TabItem x:Name="DatabricksTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DatabricksDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Databricks SQL"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ext_Host}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                    <TextBox x:Name="DbHostBox" Padding="4,3"/>
                    <TextBlock Text="{DynamicResource Ext_Warehouse}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <TextBox x:Name="DbWarehouseBox" Padding="4,3" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ext_Catalogo}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="DbCatalogBox" Padding="4,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Ext_Schema}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="DbSchemaBox" Padding="4,3"/>
                        </StackPanel>
                    </Grid>
                    <!-- Schemas de gravação: escrita só neles (fora = bloqueada), para não criar nada em produção. -->
                    <TextBlock Text="{DynamicResource Ext_DbSchemasGravacao}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <TextBox x:Name="DbWriteSchemasBox" Padding="4,3" FontFamily="Consolas"/>
                    <TextBlock Text="{DynamicResource Ext_DbSchemasGravacaoDica}" TextWrapping="Wrap" FontSize="11" Foreground="DimGray" Margin="0,2,0,0"/>
                    <TextBlock Text="{DynamicResource Ext_TokenDatabricks}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="DbTokenBox" Padding="4,3"/>
                    <TextBlock x:Name="DbTokenState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#24527A" Text="{DynamicResource Ext_DatabricksGate}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="DbTestButton" Content="{DynamicResource Ext_TestarDatabricks}" Style="{StaticResource SubtleButton}" Click="OnDatabricksTestClick"/>
                    </StackPanel>
                    <TextBlock x:Name="DbStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ============================== Git ============================== -->
            <TabItem x:Name="GitTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="GitDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Git (GitHub · Azure DevOps)"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ext_GitHubToken}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="GhTokenBox" Padding="4,3"/>
                    <TextBlock x:Name="GhTokenState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="{DynamicResource Ext_DevOpsOrg}" Style="{StaticResource Muted}" Margin="0,10,0,2"/>
                    <TextBox x:Name="AdoOrgBox" Padding="4,3"/>
                    <TextBlock Text="{DynamicResource Ext_DevOpsPat}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="AdoPatBox" Padding="4,3"/>
                    <TextBlock x:Name="AdoPatState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#24527A" Text="{DynamicResource Ext_GitGate}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="GhTestButton" Content="{DynamicResource Ext_TestarGitHub}" Style="{StaticResource SubtleButton}" Click="OnGitHubTestClick"/>
                        <Button x:Name="AdoTestButton" Content="{DynamicResource Ext_TestarDevOps}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnDevOpsTestClick"/>
                    </StackPanel>
                    <TextBlock x:Name="GitStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ============================== Work items ============================== -->
            <!-- Azure DevOps e GitHub Projects. Em branco = usa a conexão do NXProject (só leitura). -->
            <TabItem x:Name="WorkItemsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="WorkItemsDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Work items (DevOps · GitHub)"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#24527A" Text="{DynamicResource Ext_WiIntro}"/>
                    </Border>

                    <TextBlock Text="AZURE DEVOPS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="WiAdoOrigin" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ext_DevOpsOrg}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="WiAdoOrgBox" Padding="4,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Ext_WiProjeto}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="WiAdoProjectBox" Padding="4,3"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource Ext_WiDevOpsPat}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="WiAdoPatBox" Padding="4,3"/>
                    <TextBlock x:Name="WiAdoPatState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="WiAdoTestButton" Content="{DynamicResource Ext_TestarDevOps}" Style="{StaticResource SubtleButton}" Click="OnWiDevOpsTestClick"/>
                        <Button Content="{DynamicResource Ext_WiUsarNXProject}" Style="{StaticResource NavButton}" Margin="8,0,0,0" Click="OnWiDevOpsClearClick"/>
                    </StackPanel>

                    <TextBlock Text="GITHUB PROJECTS" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="WiGhOrigin" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ext_WiDono}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="WiGhOwnerBox" Padding="4,3"/>
                        </StackPanel>
                        <CheckBox x:Name="WiGhOrgCheck" Grid.Column="2" Content="{DynamicResource Ext_WiOrganizacao}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource Ext_WiNumeroProjeto}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="WiGhNumberBox" Padding="4,3"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource Ext_WiGitHubToken}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="WiGhTokenBox" Padding="4,3"/>
                    <TextBlock x:Name="WiGhTokenState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="WiGhTestButton" Content="{DynamicResource Ext_WiTestarGitHubProjects}" Style="{StaticResource SubtleButton}" Click="OnWiGitHubTestClick"/>
                        <Button Content="{DynamicResource Ext_WiUsarNXProject}" Style="{StaticResource NavButton}" Margin="8,0,0,0" Click="OnWiGitHubClearClick"/>
                    </StackPanel>
                    <TextBlock x:Name="WiStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ============================== Teams ============================== -->
            <!-- Webhook de um canal: a URL já tem a autorização (cifrada aqui). Só o aviso curto sai. -->
            <TabItem x:Name="TeamsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="TeamsDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Teams"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ext_TeamsUrl}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="TeamsUrlBox" Padding="4,3" PasswordChanged="OnTeamsUrlChanged"/>
                    <TextBlock x:Name="TeamsUrlState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#24527A" Text="{DynamicResource Ext_TeamsComo}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Ext_TeamsEnviar}" Style="{StaticResource SectionHeader}" Margin="0,12,0,4"/>
                    <WrapPanel>
                        <CheckBox x:Name="TeamsDecisionsCheck" Content="{DynamicResource Ext_TeamsDecisoes}" Margin="0,0,16,4"/>
                        <CheckBox x:Name="TeamsTasksCheck" Content="{DynamicResource Ext_TeamsTarefas}" Margin="0,0,16,4"/>
                        <CheckBox x:Name="TeamsFailuresCheck" Content="{DynamicResource Ext_TeamsFalhas}" Margin="0,0,16,4"/>
                        <CheckBox x:Name="TeamsMessagesCheck" Content="{DynamicResource Ext_TeamsMensagens}" Margin="0,0,16,4"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Ext_TeamsAssuntos}" Style="{StaticResource SectionHeader}" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="TeamsAllSubjects" Content="{DynamicResource Ext_TeamsTodosAssuntos}" GroupName="TeamsSubjects" Margin="0,0,16,0" Checked="OnTeamsSubjectsModeChanged"/>
                        <RadioButton x:Name="TeamsSomeSubjects" Content="{DynamicResource Ext_TeamsSoMarcados}" GroupName="TeamsSubjects" Checked="OnTeamsSubjectsModeChanged"/>
                    </StackPanel>
                    <!-- "Agrupador › assunto", como na Nova tarefa. -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" MaxHeight="130">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TeamsSubjectsPanel"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{DynamicResource Ext_TeamsAssuntosDica}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{DynamicResource Ext_TeamsOQueSai}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="TeamsTestButton" Content="{DynamicResource Ext_TeamsTestar}" Style="{StaticResource SubtleButton}" Click="OnTeamsTestClick"/>
                        <Button Content="{DynamicResource Ext_TeamsRemover}" Style="{StaticResource NavButton}" Margin="8,0,0,0" Click="OnTeamsClearClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TeamsStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ============================== E-mail ============================== -->
            <TabItem x:Name="MailTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MailDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="E-mail (Outlook · Gmail)"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Background="#FFF4E5" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9A5B00" Text="{DynamicResource Ext_EmailAviso}"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ext_OutlookClient}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="OutlookClientBox" Padding="4,3" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Ext_OutlookTenant}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="OutlookTenantBox" Padding="4,3"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="OutlookLoginButton" Content="{DynamicResource Ext_Entrar}" Style="{StaticResource PrimaryButton}" Click="OnOutlookLoginClick"/>
                            <Button Content="{DynamicResource Ext_Sair}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnOutlookSignOutClick"/>
                            <Button x:Name="OutlookTestButton" Content="{DynamicResource Ext_TestarEmail}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnOutlookTestClick"/>
                        </StackPanel>
                        <TextBlock x:Name="OutlookSession" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="{DynamicResource Ext_GmailClient}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                    <TextBox x:Name="GmailClientBox" Padding="4,3" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    <TextBlock Text="{DynamicResource Ext_GmailSecret}" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="GmailSecretBox" Padding="4,3"/>
                    <TextBlock x:Name="GmailSecretState" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="GmailLoginButton" Content="{DynamicResource Ext_Entrar}" Style="{StaticResource PrimaryButton}" Click="OnGmailLoginClick"/>
                            <Button Content="{DynamicResource Ext_Sair}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnGmailSignOutClick"/>
                            <Button x:Name="GmailTestButton" Content="{DynamicResource Ext_TestarEmail}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnGmailTestClick"/>
                        </StackPanel>
                        <TextBlock x:Name="GmailSession" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBox x:Name="MailStatus" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             FontSize="12" Margin="0,10,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>

            <!-- ============================== NXProject (gravar work items pelo NXProject instalado) ============================== -->
            <TabItem x:Name="NXProjectTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="NXProjectDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="NXProject (DevOps · GitProject)"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock x:Name="NxpInstalled" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                    <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <TextBlock x:Name="NxpHow" TextWrapping="Wrap" FontSize="12" Foreground="#24527A"/>
                    </Border>
                    <TextBlock Text="AZURE DEVOPS" Style="{StaticResource SectionHeader}" Margin="0,12,0,2"/>
                    <TextBlock x:Name="NxpDevOps" TextWrapping="Wrap" FontSize="12"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="NxpDevOpsCheck" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Click="OnNxpCheckDevOpsClick"/>
                        <TextBlock x:Name="NxpDevOpsResult" TextWrapping="Wrap" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="GITHUB PROJECTS (GITPROJECT)" Style="{StaticResource SectionHeader}" Margin="0,14,0,2"/>
                    <TextBlock x:Name="NxpGit" TextWrapping="Wrap" FontSize="12"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="NxpGitCheck" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Click="OnNxpCheckGitClick"/>
                        <TextBlock x:Name="NxpGitResult" TextWrapping="Wrap" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- ============================== Power BI Desktop ============================== -->
            <TabItem x:Name="PowerBiTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PowerBiDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Power BI Desktop"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock x:Name="PowerBiLocation" TextWrapping="Wrap" FontSize="12"/>
                    <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#24527A" Text="{DynamicResource Ext_PowerBiComo}"/>
                    </Border>
                    <!-- Workspace de novos PBI: o agente usa nos parâmetros do projeto (powerbi_info). -->
                    <TextBlock Text="{DynamicResource Ext_PowerBiWorkspace}" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Ext_PowerBiWorkspaceNome}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PowerBiWorkspaceName" Grid.Column="1" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Ext_PowerBiWorkspaceId}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PowerBiWorkspaceId" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Ext_PowerBiWorkspaceDica}" TextWrapping="Wrap" FontSize="11" Foreground="DimGray" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="PowerBiTestButton" Content="{DynamicResource Ext_PowerBiTestar}" Style="{StaticResource SubtleButton}" Click="OnPowerBiTestClick"/>
                    </StackPanel>
                    <TextBox x:Name="PowerBiStatus" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ============================== Janelas do Windows ============================== -->
            <TabItem x:Name="WindowsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="WindowsDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Ext_JanelasTitulo}"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Background="#FFF4E5" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9A5B00" Text="{DynamicResource Ext_JanelasAviso}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{DynamicResource Ext_JanelasLerApp}" Style="{StaticResource PrimaryButton}" Click="OnReadAppClick"/>
                        <Button Content="{DynamicResource Ext_JanelasProcessos}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnProcessesClick"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Ext_JanelasLiberados}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                    <TextBox x:Name="AllowedAppsBox" AcceptsReturn="True" Height="54" Padding="4,3" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <Button Content="{DynamicResource Ext_JanelasListar}" Style="{StaticResource SubtleButton}" Click="OnListWindowsClick"/>
                        <Button x:Name="WindowCaptureButton" Content="{DynamicResource Ext_JanelasCapturar}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" IsEnabled="False" Click="OnWindowCaptureClick"/>
                        <Button x:Name="WindowReadButton" Content="{DynamicResource Ext_JanelasLer}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" IsEnabled="False" Click="OnWindowReadClick"/>
                    </StackPanel>
                    <ListBox x:Name="WindowsList" Height="110" FontSize="12" SelectionChanged="OnWindowSelected"/>
                    <TextBox x:Name="WindowsStatus" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             FontSize="12" Margin="0,8,0,0" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Ext_Cancelar}" Style="{StaticResource SubtleButton}" IsCancel="True"/>
            <Button Content="{DynamicResource Ext_Salvar}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnSaveClick"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
