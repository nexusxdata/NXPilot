<Window x:Class="NXPilot.Desktop.Views.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Tl_Titulo}" Width="1040" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Hist_Fechar}" Style="{StaticResource SubtleButton}" IsCancel="True" Click="OnCloseClick"/>
            <Button x:Name="WorktreeButton" DockPanel.Dock="Right" Content="{DynamicResource Hist_AbrirWorktree}" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnWorktreeClick"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl>
            <TabItem Header="{DynamicResource Tl_Eventos}">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource Tl_ExpandirTudo}" Style="{StaticResource SubtleButton}" Padding="8,2" FontSize="12" Click="OnExpandAllClick"/>
                            <Button Content="{DynamicResource Tl_RecolherTudo}" Style="{StaticResource SubtleButton}" Padding="8,2" FontSize="12" Margin="6,0,0,0" Click="OnCollapseAllClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAll" Content="{DynamicResource Tl_Tudo}" IsChecked="True" Margin="0,0,14,0" Checked="OnFilterChanged"/>
                            <RadioButton x:Name="FilterDecisions" Content="{DynamicResource Tl_Decisoes}" Margin="0,0,14,0" Checked="OnFilterChanged"/>
                            <RadioButton x:Name="FilterPhases" Content="{DynamicResource Tl_Fases}" Margin="0,0,14,0" Checked="OnFilterChanged"/>
                            <RadioButton x:Name="FilterProblems" Content="{DynamicResource Tl_Problemas}" Checked="OnFilterChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Árvore: etapa (recolhida) → evento em uma linha (expande para o texto completo). -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnEventsSizeChanged">
                        <ItemsControl x:Name="GroupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="8,4" Margin="0,0,0,6">
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <TextBlock>
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="Gray" FontSize="12"/>
                                                </TextBlock>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Events}" Margin="18,4,0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,1">
                                                            <Expander.Header>
                                                                <Grid Width="{DynamicResource EventHeaderWidth}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="64"/>
                                                                        <ColumnDefinition Width="22"/>
                                                                        <ColumnDefinition Width="170"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Time}" Foreground="Gray" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold"/>
                                                                    <TextBlock Grid.Column="2" Foreground="{Binding Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" · " Foreground="Gray"/><Run Text="{Binding Kind, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="3" Text="{Binding OneLine}" TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Expander.Header>
                                                            <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                     Margin="86,2,8,6" Padding="6" BorderBrush="{StaticResource BorderBrush}"/>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Tl_Commits}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="CommitList" SelectionChanged="OnCommitChanged" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                        <Run Text="{Binding ShortSha, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/><Run Text="  ·  "/><Run Text="{Binding When, Mode=OneWay, StringFormat='dd/MM HH:mm:ss'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoCommitsText" Text="{DynamicResource Tl_SemCommits}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="8" Visibility="Collapsed"/>
                    <ListBox x:Name="DiffList" Grid.Column="2" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
