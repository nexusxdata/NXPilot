<Window x:Class="NXPilot.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Cfg_Titulo}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22,18">
        <TextBlock Text="{DynamicResource Cfg_Titulo}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>

        <!-- Versão: atualizar e voltar (pacotes NXPilot-Release.zip das releases do GitHub). -->
        <TextBlock Text="{DynamicResource Cfg_Versao}" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>
        <TextBlock x:Name="CurrentVersionText" FontSize="13"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CheckButton" Content="{DynamicResource Cfg_Verificar}" Style="{StaticResource PrimaryButton}" Click="OnCheckClick"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Cfg_VoltarVersao}" Style="{StaticResource Muted}" Margin="0,16,0,2"/>
        <DockPanel>
            <Button x:Name="InstallVersionButton" DockPanel.Dock="Right" Content="{DynamicResource Cfg_InstalarVersao}" Style="{StaticResource SubtleButton}"
                    Margin="8,0,0,0" IsEnabled="False" Click="OnInstallVersionClick"/>
            <ComboBox x:Name="VersionsBox" Padding="6,3" SelectionChanged="OnVersionSelected"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Cfg_VoltarNota}"/>

        <Border x:Name="SetupBanner" Background="#FFF4E5" CornerRadius="4" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Cfg_BaixarSetup}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnSetupClick"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9A5B00" VerticalAlignment="Center" Text="{DynamicResource Cfg_SetupMudou}"/>
            </DockPanel>
        </Border>

        <ProgressBar x:Name="Progress" Height="14" Margin="0,14,0,0" Minimum="0" Maximum="100" IsIndeterminate="True" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Cfg_Fechar}" Style="{StaticResource SubtleButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
