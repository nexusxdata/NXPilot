<Window x:Class="NXPilot.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Cfg_Titulo}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22,18">
        <TextBlock Text="{DynamicResource Cfg_Titulo}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>

        <!-- Versão: atualizar e voltar (pacotes NXPilot-Release.zip das releases do GitHub). -->
        <TextBlock Text="{DynamicResource Cfg_Versao}" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>
        <TextBlock x:Name="CurrentVersionText" FontSize="13"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CheckButton" Content="{DynamicResource Cfg_Verificar}" Style="{StaticResource PrimaryButton}" Click="OnCheckClick"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Cfg_VoltarVersao}" Style="{StaticResource Muted}" Margin="0,16,0,2"/>
        <DockPanel>
            <Button x:Name="InstallVersionButton" DockPanel.Dock="Right" Content="{DynamicResource Cfg_InstalarVersao}" Style="{StaticResource SubtleButton}"
                    Margin="8,0,0,0" IsEnabled="False" Click="OnInstallVersionClick"/>
            <ComboBox x:Name="VersionsBox" Padding="6,3" SelectionChanged="OnVersionSelected"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Cfg_VoltarNota}"/>

        <Border x:Name="SetupBanner" Background="#FFF4E5" CornerRadius="4" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Cfg_BaixarSetup}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnSetupClick"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9A5B00" VerticalAlignment="Center" Text="{DynamicResource Cfg_SetupMudou}"/>
            </DockPanel>
        </Border>

        <!-- MCP NXPilot: as extensões como ferramentas do agente; ligar/parar (o estado fica guardado). -->
        <TextBlock Text="{DynamicResource Cfg_Mcp}" Style="{StaticResource SectionHeader}" Margin="0,18,0,6"/>
        <DockPanel>
            <Button x:Name="McpButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" MinWidth="80" Click="OnMcpToggleClick"/>
            <Ellipse x:Name="McpDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="McpStatusText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Cfg_McpNota}"/>
        <Expander Header="{DynamicResource Cfg_McpFerramentas}" Margin="0,6,0,0" FontSize="12">
            <TextBlock x:Name="McpToolsText" TextWrapping="Wrap" FontSize="11" Margin="16,4,0,0"/>
        </Expander>

        <!-- Regras do plano por agente: vão no fim de TODO pedido de plano (no plano só se lê e propõe). -->
        <TextBlock x:Name="PlanRulesHeader" Style="{StaticResource SectionHeader}" Margin="0,18,0,6"/>
        <DockPanel>
            <Button x:Name="PlanRulesResetButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnPlanRulesResetClick"/>
            <ComboBox x:Name="PlanRulesAgentBox" Width="170" HorizontalAlignment="Left" Padding="6,3" SelectionChanged="OnPlanRulesAgentChanged">
                <ComboBoxItem Content="Claude Code" Tag="Claude"/>
                <ComboBoxItem Content="Codex" Tag="Codex"/>
                <ComboBoxItem Content="NXAgentic" Tag="NXAgentic"/>
            </ComboBox>
        </DockPanel>
        <TextBox x:Name="PlanRulesBox" Margin="0,6,0,0" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontSize="12" Padding="6,4" LostFocus="OnPlanRulesLostFocus"/>
        <TextBlock x:Name="PlanRulesNote" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <ProgressBar x:Name="Progress" Height="14" Margin="0,14,0,0" Minimum="0" Maximum="100" IsIndeterminate="True" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Cfg_Fechar}" Style="{StaticResource SubtleButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
