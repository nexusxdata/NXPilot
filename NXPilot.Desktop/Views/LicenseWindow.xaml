<Window x:Class="NXPilot.Desktop.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lic_Titulo}" Width="700" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <!-- Padding num Border (e não Margin no Grid): a captura (shot) renderiza o conteúdo sem deslocar. -->
    <Border Padding="22,18">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Lic_Cabecalho}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Lic_Subtitulo}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lic_Empresa}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Lic_Contato}" Margin="0,2,0,14"/>
                    <TextBlock Text="{DynamicResource Lic_Resumo}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P1}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P2}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P3}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P4}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P5}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P6}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P7}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P8}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <!-- O resumo não é o contrato: vale o LICENSE.txt, aberto no GitHub (a URL acompanha o idioma). -->
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="{DynamicResource Lic_TextoCompleto}"/>
                        <Hyperlink Click="OnFullTextClick"><Run x:Name="FullTextUrlRun"/></Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="AcceptNote" Text="{DynamicResource Lic_NotaAceite}" TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Style="{StaticResource Muted}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <!-- Consulta (Sobre / menu "?"): selo com a data do aceite e só o Fechar. -->
            <TextBlock x:Name="AcceptedSeal" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="#107C10" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="{DynamicResource Help_Fechar}" Style="{StaticResource SubtleButton}" MinWidth="100"
                        IsCancel="True" Visibility="Collapsed" Click="OnCloseClick"/>
                <!-- Primeira execução: Sair encerra o app; Aceitar registra o termo. -->
                <Button x:Name="DeclineButton" Content="{DynamicResource Lic_Sair}" Style="{StaticResource SubtleButton}" MinWidth="100"
                        Margin="0,0,8,0" Click="OnDeclineClick"/>
                <Button x:Name="AcceptButton" Content="{DynamicResource Lic_Aceitar}" Style="{StaticResource PrimaryButton}" MinWidth="160"
                        IsDefault="True" Click="OnAcceptClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    </Border>
</Window>
