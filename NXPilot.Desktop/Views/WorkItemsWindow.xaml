<Window x:Class="NXPilot.Desktop.Views.WorkItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="620" MinWidth="900" MinHeight="380" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <Border Padding="22,18">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <!-- Origem: Azure DevOps ou GitHub Projects (só as configuradas, na extensão Work items ou no NXProject). -->
            <!-- Work item Project (DevOps) ou issue Project (GitHub): o projeto executado; filtra pelos descendentes dele. -->
            <ComboBox x:Name="RootBox" DockPanel.Dock="Right" Width="260" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="OnRootChanged"/>
            <!-- Projeto: os da organização (DevOps) ou do dono (GitHub); começa no último escolhido. -->
            <ComboBox x:Name="ProjectBox" DockPanel.Dock="Right" Width="210" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="OnProjectChanged"/>
            <ComboBox x:Name="SourceBox" DockPanel.Dock="Right" Width="160" Padding="8,5" VerticalAlignment="Top" SelectionChanged="OnSourceChanged"/>
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="SubHeading" Style="{StaticResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Duas linhas: a situação em cima e os botões embaixo (texto longo não estica os botões). -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ConfigureButton" Style="{StaticResource SubtleButton}" Click="OnConfigureClick"/>
                <Button x:Name="RefreshButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnRefreshClick"/>
                <Button x:Name="OpenWebButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnOpenWebClick"/>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnCreateClick"/>
                <Button x:Name="CloseButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="Grid" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnCreateClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColId" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn x:Name="ColType" Binding="{Binding Type}" Width="90"/>
                    <DataGridTextColumn x:Name="ColTitle" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn x:Name="ColState" Binding="{Binding State}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailCriteriaLabel" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="DetailCriteria" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
