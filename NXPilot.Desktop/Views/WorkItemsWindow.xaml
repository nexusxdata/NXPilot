<Window x:Class="NXPilot.Desktop.Views.WorkItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1420" Height="660" MinWidth="1040" MinHeight="380" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <Border Padding="22,18">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <!-- Origem: Azure DevOps ou GitHub Projects (só as configuradas, na extensão Work items ou no NXProject). -->
            <!-- Work item Project (DevOps) ou issue Project (GitHub): o projeto executado; filtra pelos descendentes dele. -->
            <!-- DevOps: minhas abertas ou a hierarquia inteira do Work Item Project (Epic, Feature, Story, Task — qualquer um vira a tarefa). -->
            <!-- Estado: abertas (não fechadas), em execução, fechadas ou todas — vale para as duas listas. -->
            <ComboBox x:Name="StateBox" DockPanel.Dock="Right" Width="140" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="OnStateFilterChanged"/>
            <ComboBox x:Name="ScopeBox" DockPanel.Dock="Right" Width="290" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="OnScopeChanged"/>
            <ComboBox x:Name="RootBox" DockPanel.Dock="Right" Width="260" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="OnRootChanged"/>
            <!-- Projeto: os da organização (DevOps) ou do dono (GitHub); começa no último escolhido. -->
            <ComboBox x:Name="ProjectBox" DockPanel.Dock="Right" Width="210" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="OnProjectChanged"/>
            <ComboBox x:Name="SourceBox" DockPanel.Dock="Right" Width="160" Padding="8,5" VerticalAlignment="Top" SelectionChanged="OnSourceChanged"/>
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="SubHeading" Style="{StaticResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Duas linhas: a situação em cima e os botões embaixo (texto longo não estica os botões). -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="ClearMarksButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="8,0" Margin="8,0,0,0" FontSize="11" Visibility="Collapsed" Click="OnClearMarksClick"/>
                <TextBlock x:Name="MarkedText" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            </DockPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ExpandAllButton" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnExpandAllClick" Visibility="Collapsed"/>
                <Button x:Name="CollapseAllButton" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnCollapseAllClick" Visibility="Collapsed"/>
                <Button x:Name="ConfigureButton" Style="{StaticResource SubtleButton}" Click="OnConfigureClick"/>
                <Button x:Name="RefreshButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnRefreshClick"/>
                <Button x:Name="OpenWebButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnOpenWebClick"/>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnCreateClick"/>
                <Button x:Name="CloseButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="Grid" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                <DataGrid.Columns>
                    <!-- ☐ marca vários itens (qualquer nível): cada um vira uma citação na Nova tarefa. -->
                    <DataGridTemplateColumn x:Name="ColCheck" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColId" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn x:Name="ColType" Binding="{Binding Type}" Width="90"/>
                    <!-- Título com recuo pelo nível e ▶/▼ (árvore: Project → EPIC/EPIC_GROUP → Feature → Story → Task). -->
                    <DataGridTemplateColumn x:Name="ColTitle" Width="*" SortMemberPath="Title" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding Title}">
                                    <TextBlock Text="{Binding Glyph}" Width="16" Cursor="Hand" Foreground="{StaticResource PrimaryBrush}"
                                               MouseLeftButtonDown="OnToggleClick" Background="Transparent"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CountText}" Foreground="#888888"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColState" Binding="{Binding State}" Width="90"/>
                    <DataGridTextColumn x:Name="ColAssigned" Binding="{Binding AssignedTo}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailCriteriaLabel" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="DetailCriteria" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
