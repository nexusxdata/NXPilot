<Window x:Class="NXPilot.Desktop.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <!-- Pede um texto (ex.: o {texto} da execução de teste ou do disparo manual de um hook). -->
    <Border Padding="22,18">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Message" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <TextBox x:Name="InputBox" Height="150" Padding="6,5" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}" IsCancel="True"/>
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnOkClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
