<Window x:Class="NXPilot.Desktop.Views.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Subj_Titulo}" Width="820" Height="540" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource Subj_Titulo}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Subj_Subtitulo}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Subj_PastaSombra}" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource Subj_Alterar}" Style="{StaticResource SubtleButton}" Padding="10,4" Margin="6,0,0,0" Click="OnChangeRootClick"/>
                            <Button x:Name="DefaultRootButton" Content="{DynamicResource Subj_UsarPadrao}" Style="{StaticResource SubtleButton}" Padding="10,4" Margin="6,0,0,0" Click="OnDefaultRootClick"/>
                        </StackPanel>
                        <TextBlock x:Name="RootText" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Subj_PastaSombraDica}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Hist_Fechar}" Style="{StaticResource SubtleButton}" IsCancel="True" Click="OnCloseClick"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Subj_Assuntos}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Subj_Criar}" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="6,0,0,0" Click="OnCreateClick"/>
                    <TextBox x:Name="NewNameBox" Padding="4,4" KeyDown="OnNewNameKeyDown"/>
                </DockPanel>
                <ListBox x:Name="SubjectList" DisplayMemberPath="Name" SelectionChanged="OnSubjectChanged"/>
            </DockPanel>

            <StackPanel Grid.Column="2" x:Name="DetailPanel">
                <TextBlock x:Name="SubjectName" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubjectPath" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="{DynamicResource Subj_AbrirPasta}" Style="{StaticResource SubtleButton}" Margin="0,0,8,6" Click="OnOpenFolderClick"/>
                    <Button Content="{DynamicResource Subj_MoverPasta}" Style="{StaticResource SubtleButton}" Margin="0,0,8,6" Click="OnMoveClick"/>
                </WrapPanel>

                <!-- GitHub (opcional): recolhido como o "Ver ferramentas" do Configurar; expande quando for configurar. -->
                <Expander x:Name="GitHubExpander" Header="GitHub" Margin="0,12,0,0" FontSize="12">
                    <StackPanel Margin="16,4,0,0">
                        <TextBlock x:Name="GitHubText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="GitHubButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="6,0,0,0" Click="OnGitHubClick"/>
                            <TextBlock x:Name="RepoNameLabel" DockPanel.Dock="Left" Text="{DynamicResource Subj_NomeRepo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RepoNameBox" Padding="4,4" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
