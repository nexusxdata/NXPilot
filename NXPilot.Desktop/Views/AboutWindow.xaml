<Window x:Class="NXPilot.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_Titulo}" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <!-- Rolagem: com zoom de 125% a janela poderia passar da tela. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20">
        <DockPanel Margin="0,0,0,12">
            <Image x:Name="CompanyLogoImage" DockPanel.Dock="Left" Width="130" Height="130" Stretch="Uniform" Margin="0,0,18,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NXPilot Community" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
                <TextBlock Text="{DynamicResource Main_Slogan}" FontStyle="Italic" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{DynamicResource About_Descricao}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <TextBlock Text="{DynamicResource About_Empresa}" FontWeight="SemiBold"/>
                <TextBlock Text="Nexus XData Tecnologia Ltda" Margin="0,2,0,10"/>

                <TextBlock Text="{DynamicResource About_GitHub}" FontWeight="SemiBold"/>
                <TextBlock Margin="0,2,0,10">
                    <Hyperlink Click="OnGitHubClick">https://github.com/nexusxdata/NXPilot</Hyperlink>
                </TextBlock>

                <TextBlock Text="{DynamicResource About_Licenca}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource About_LicencaTexto}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                <Button Content="{DynamicResource About_VerLicenca}" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                        Margin="0,0,0,10" Click="OnLicenseClick"/>

                <TextBlock Text="{DynamicResource About_NovasVersoes}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource About_NovasVersoesTexto}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                <!-- Outro produto da mesma empresa: informação no Sobre, nunca no fluxo de atualização. -->
                <TextBlock Text="{DynamicResource About_NXProject}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource About_NXProjectTexto}" Margin="0,2,0,4" TextWrapping="Wrap"/>
                <TextBlock Margin="0,0,0,10">
                    <Hyperlink Click="OnNXProjectClick"><Run Text="{DynamicResource About_NXProjectLink}"/></Hyperlink>
                </TextBlock>

                <TextBlock Text="{DynamicResource About_Contato}" FontWeight="SemiBold"/>
                <TextBlock Margin="0,2,0,0">
                    <Hyperlink Click="OnEmailClick">comercial.nexus.xdata@gmail.com</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <Button Content="{DynamicResource Help_Fechar}" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
                Margin="0,16,0,0" MinWidth="90" IsDefault="True" IsCancel="True" Click="OnCloseClick"/>
    </StackPanel>
    </ScrollViewer>
</Window>
