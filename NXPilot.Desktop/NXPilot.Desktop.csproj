<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- O "NX" da Nexus XData: N azul e a perna de baixo do X em laranja, a cor do NXPilot (o mesmo logo da tela Sobre). -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>NXPilot</AssemblyTitle>
    <!-- O projeto continua NXPilot; só o executável se chama NxPilot.exe. -->
    <AssemblyName>NxPilot</AssemblyName>
    <RootNamespace>NXPilot.Desktop</RootNamespace>
    <!-- Main próprio (Program.cs): desvia para o modo hook do agente antes de iniciar o WPF. -->
    <StartupObject>NXPilot.Desktop.Program</StartupObject>
    <!-- Todo restore (até o build comum da solution) já inclui o alvo win-x64 do publish: sem
         isso o projeto temporário do WPF (*_wpftmp) lê um project.assets.json sem win-x64 e o
         publish falha com NETSDK1047. Não muda a pasta de saída do build. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo da tela Sobre: NX da Nexus XData, N azul e perna de baixo do X em laranja (protegido como no NXProject). -->
    <EmbeddedResource Include="Assets\logo-nxpilot.enc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NXPilot.Core\NXPilot.Core.csproj" />
    <!-- Janelas do Windows (FlaUI, MIT): extensões "Power BI Desktop" e "Automatizar janelas do Windows". -->
    <ProjectReference Include="..\NXPilot.WindowsUi\NXPilot.WindowsUi.csproj" />
  </ItemGroup>

</Project>
