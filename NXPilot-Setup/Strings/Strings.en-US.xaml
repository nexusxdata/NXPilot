<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Installer UI strings in English. Mesmas chaves nos dois arquivos. -->
    <sys:String x:Key="Setup_NexusXdataInstallNxpilot">Nexus Xdata Install — NXPilot</sys:String>
    <sys:String x:Key="Setup_AbrirNxpilot">Open NXPilot</sys:String>
    <sys:String x:Key="Setup_Fechar">Close</sys:String>
    <sys:String x:Key="Setup_InteligenciaArtificialAutomaticaE">Automatic, not autonomous AI — because you are in control.</sys:String>
    <sys:String x:Key="Setup_OrquestradorDeAgentesDe">Coding agent orchestrator (Claude Code, Codex) with audit log and decisions. NXPilot installs in your user profile, without administrator; only .NET (step 1) asks for administrator.</sys:String>
    <sys:String x:Key="Setup_1InstalarONxpilot">2 · Install NXPilot</sys:String>
    <sys:String x:Key="Setup_Instalar">Install</sys:String>
    <sys:String x:Key="Setup_2ClassificadorDeRisco">4 · ONNX risk classifier (recommended)</sys:String>
    <sys:String x:Key="Setup_ModeloAllMinilmL6">all-MiniLM-L6-v2 model (~90 MB) that classifies each agent action in milliseconds, on the CPU — no GPU needed. Without it NXPilot uses rules only.</sys:String>
    <sys:String x:Key="Setup_BaixarModelo">Download model</sys:String>
    <sys:String x:Key="Setup_3AgentesDeCodigo">3 · Coding agents</sys:String>
    <sys:String x:Key="Setup_ONxpilotCoordenaOs">NXPilot coordinates the agents you already use, with your own subscription. Install at least one.</sys:String>
    <sys:String x:Key="Setup_Copiar">Copy</sys:String>
    <sys:String x:Key="Setup_RodeOComandoNum">Run the command in PowerShell and then click Check again. Installations inside WSL are recognized too.</sys:String>
    <sys:String x:Key="Setup_VerificarDeNovo">Check again</sys:String>
    <sys:String x:Key="Setup_4IaLocalLlama">5 · Local AI LLaMA (optional)</sys:String>
    <sys:String x:Key="Setup_UsadaSoNasAcoes">Used only for actions where ONNX is unsure (cascade). It is the same Local AI as NXProject — if it already installed it, nothing to do. Otherwise, install it here: the LLaMA backend and the Qwen3-4B-2507 model (Apache-2.0, ~2.5 GB), in the same folder NXProject uses.</sys:String>
    <sys:String x:Key="Setup_AbrirPasta">open folder</sys:String>
    <sys:String x:Key="Setup_ComoInstalar">How to install</sys:String>
    <sys:String x:Key="Setup_ModoInterno">Automatic (recommended)</sys:String>
    <sys:String x:Key="Setup_ModoScript">Official script</sys:String>
    <sys:String x:Key="Setup_Versao">Version</sys:String>
    <sys:String x:Key="Setup_NotaAgentes">Automatic: in your user area, no administrator and no script. After installing, sign in by running claude or codex once in a terminal.</sys:String>
    <sys:String x:Key="Setup_ModoInternoTip">Automatic install in your user area (no administrator): the Setup downloads from the official site, checks the SHA-256 and installs without running a script — use it if your antivirus blocks PowerShell.</sys:String>
    <sys:String x:Key="Setup_ModoScriptTip">Runs the official installer (Anthropic / OpenAI) in a PowerShell window. Some antivirus tools block it — if so, use Automatic.</sys:String>
    <sys:String x:Key="Setup_CopiarTip">Copies the official command to install manually (paste it into PowerShell).</sys:String>
    <sys:String x:Key="Setup_InstalarAgenteTip">Installs the way chosen above. Automatic: your user area, no administrator.</sys:String>
    <sys:String x:Key="Setup_1DotNet">1 · .NET 10 Desktop Runtime (~58 MB)</sys:String>
    <sys:String x:Key="Setup_DotNetNota">NXPilot already carries the runtime next to the exe; with .NET installed on the machine, Windows does not ask to "install .NET" if a runtime file goes missing (antivirus, interrupted copy). Asks for administrator.</sys:String>
    <sys:String x:Key="Setup_DotNetInstalar">Install .NET 10</sys:String>
    <sys:String x:Key="Setup_DotNetManual">Download in browser</sys:String>
    <!-- Passo 5: instalar a IA Local -->
    <sys:String x:Key="Setup_InstalarIaLocal">Install Local AI (~2.5 GB)</sys:String>
    <sys:String x:Key="Setup_Cancelar">Cancel</sys:String>
    <!-- Abas do Setup -->
    <sys:String x:Key="Setup_AbaInstalacao">1 · Installation and updates</sys:String>
    <sys:String x:Key="Setup_AbaAgentes">2 · Agents and AI</sys:String>
</ResourceDictionary>
